-- 1. Category Table
CREATE TABLE CATEGORY (
    category_id INT PRIMARY KEY,
    category_name VARCHAR2(50) NOT NULL
);

-- 2. Subcategory Table
CREATE TABLE SUBCATEGORY (
    sub_id INT PRIMARY KEY,
    subcategory_name VARCHAR2(50) NOT NULL,
    category_id INT REFERENCES CATEGORY(category_id)
);

-- 3. Vendor Table 
CREATE TABLE VENDOR (
    vendor_id INT PRIMARY KEY,
    vendor_name VARCHAR2(100) NOT NULL,
    vendor_email VARCHAR2(100),
    vendor_phone VARCHAR2(20),
    vendor_address VARCHAR2(200)
);

-- 4. Product Table
CREATE TABLE PRODUCT (
    product_id INT PRIMARY KEY,
    product_name VARCHAR2(100) NOT NULL,
    product_price DECIMAL(10, 2) NOT NULL CHECK (product_price > 0),
    product_stock INT DEFAULT 0,
    product_description VARCHAR2(500),
    sub_id INT REFERENCES SUBCATEGORY(sub_id),
    vendor_id INT REFERENCES VENDOR(vendor_id)
);

-- 5. Product Attribute Table
CREATE TABLE PRODUCT_ATTRIBUTE (
    product_attr_id INT PRIMARY KEY,
    product_id INT REFERENCES PRODUCT(product_id),
    attr_name VARCHAR2(50),
    attr_value VARCHAR2(100)
);

-- 6. Customer Table
CREATE TABLE CUSTOMER (
    customer_id INT PRIMARY KEY,
    customer_fname VARCHAR2(50) NOT NULL,
    customer_lname VARCHAR2(50) NOT NULL,
    customer_email VARCHAR2(100) UNIQUE NOT NULL,
    customer_phone VARCHAR2(20),
    customer_password VARCHAR2(50) NOT NULL,
    customer_status VARCHAR2(20) DEFAULT 'Active'
);

-- 7. Customer Address Table
CREATE TABLE CUSTOMER_ADDRESS (
    addr_id INT PRIMARY KEY,
    customer_id INT REFERENCES CUSTOMER(customer_id),
    address_line VARCHAR2(200) NOT NULL,
    city VARCHAR2(50),
    province VARCHAR2(50),
    postal_code VARCHAR2(20),
    address_type VARCHAR2(20) -- (Home, Office...)
);

-- 8. Cart Table (Parent for Cart_Item)
CREATE TABLE CART (
    cart_id INT PRIMARY KEY,
    customer_id INT REFERENCES CUSTOMER(customer_id),
    cart_status VARCHAR2(20),
    created_date DATE DEFAULT SYSDATE
);

-- 9. Cart Item Table
CREATE TABLE CART_ITEM (
    cart_item_id INT PRIMARY KEY,
    cart_id INT REFERENCES CART(cart_id),
    product_id INT REFERENCES PRODUCT(product_id),
    quantity INT NOT NULL CHECK (quantity > 0),
    item_price DECIMAL(10, 2)
);

-- 10. Wishlist Table (Parent for Wishlist_Item)
CREATE TABLE WISHLIST (
    wishlist_id INT PRIMARY KEY,
    customer_id INT REFERENCES CUSTOMER(customer_id),
    wishlist_name VARCHAR2(50)
);

-- 11. Wishlist Item Table
CREATE TABLE WISHLIST_ITEM (
    item_id INT PRIMARY KEY,
    wishlist_id INT REFERENCES WISHLIST(wishlist_id),
    product_id INT REFERENCES PRODUCT(product_id),
    added_date DATE DEFAULT SYSDATE
);

-- 12. Orders Table
CREATE TABLE ORDERS (
    order_id INT PRIMARY KEY,
    customer_id INT REFERENCES CUSTOMER(customer_id),
    order_date DATE DEFAULT SYSDATE,
    total_amount DECIMAL(10, 2),
    order_status VARCHAR2(20)
);

-- 13. Order Item Table
CREATE TABLE ORDER_ITEM (
    order_item_id INT PRIMARY KEY,
    order_id INT REFERENCES ORDERS(order_id),
    product_id INT REFERENCES PRODUCT(product_id),
    quantity INT NOT NULL,
    item_price DECIMAL(10, 2)
);

-- 14. Shipping Table
CREATE TABLE SHIPPING (
    shipping_id INT PRIMARY KEY,
    order_id INT REFERENCES ORDERS(order_id),
    addr_id INT REFERENCES CUSTOMER_ADDRESS(addr_id),
    shipping_status VARCHAR2(50),
    shipping_date DATE,
    tracking_number VARCHAR2(50)
);

-- 15. Order Action Table (Returns/Cancellations)
CREATE TABLE ORDER_ACTION (
    action_id INT PRIMARY KEY,
    order_id INT REFERENCES ORDERS(order_id),
    action_type VARCHAR2(50), -- (Return, Refund, Cancellation)
    action_date DATE DEFAULT SYSDATE
);

