SELECT p.product_name, p.product_price, c.category_name 
FROM PRODUCT p
JOIN SUBCATEGORY s ON p.sub_id = s.sub_id
JOIN CATEGORY c ON s.category_id = c.category_id
WHERE c.category_name = 'Luxury Watches';

SELECT ci.cart_item_id, p.product_name, ci.quantity, ci.item_price
FROM CART_ITEM ci
JOIN PRODUCT p ON ci.product_id = p.product_id
JOIN CART c ON ci.cart_id = c.cart_id
WHERE c.customer_id = 3001 AND c.cart_status = 'Active';

UPDATE CUSTOMER SET customer_status = 'Inactive' WHERE customer_id = 3003;

SELECT o.order_id, s.shipping_status, s.tracking_number, s.shipping_date
FROM SHIPPING s
JOIN ORDERS o ON s.order_id = o.order_id
WHERE o.customer_id = 3001;

SELECT v.vendor_name, p.product_name, p.product_stock
FROM PRODUCT p
JOIN VENDOR v ON p.vendor_id = v.vendor_id
WHERE v.vendor_name = 'Apple Inc.';

--**********************
SELECT TO_CHAR(order_date, 'YYYY-MM') AS "Month", SUM(total_amount) AS "Total Sales"
FROM ORDERS
GROUP BY TO_CHAR(order_date, 'YYYY-MM');

SELECT p.product_name, SUM(oi.quantity) AS "Units Sold"
FROM ORDER_ITEM oi
JOIN PRODUCT p ON oi.product_id = p.product_id
GROUP BY p.product_name
ORDER BY "Units Sold" DESC;

--*************************
SELECT customer_id, SUM(total_amount) AS "Lifetime Spend",
CASE 
    WHEN SUM(total_amount) > 1000 THEN 'High Value'
    ELSE 'Standard'
END AS "Customer Category"
FROM ORDERS
GROUP BY customer_id;

SELECT w.wishlist_name, p.product_name, p.product_price
FROM WISHLIST_ITEM wi
JOIN PRODUCT p ON wi.product_id = p.product_id
JOIN WISHLIST w ON wi.wishlist_id = w.wishlist_id
WHERE w.customer_id = 3001;

--*****************************
SELECT o.order_id, o.customer_id, oa.action_type, oa.action_date
FROM ORDER_ACTION oa
JOIN ORDERS o ON oa.order_id = o.order_id
WHERE oa.action_type = 'Return';